{
  "name": "@surgeonpulse/dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@surgeonpulse/core": "*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.1",
    "jsdom": "^27.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@playwright/test": "1.63.0"
  },
  "description": "Research & performance-feedback web dashboard for SurgeonPulse session data."
}
