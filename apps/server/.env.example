# SurgeonPulse research ingest server — configuration.
#
# Copy this file to `.env` in the directory you start the server from (apps/server when you use
# `npm start`). It is read on Windows, macOS and Linux alike; variables already set in the
# environment take precedence. Never commit `.env`: it holds the admin token.

# Researcher bearer token — REQUIRED, at least 32 characters, no spaces. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=

# Port and interface. 127.0.0.1 accepts connections from this machine only (put a TLS reverse
# proxy in front). Use 0.0.0.0 in containers or to reach the server from phones on a test network.
PORT=8787
HOST=127.0.0.1

# Directory for surgeonpulse.sqlite (created with mode 0700). Relative paths are resolved from the
# directory the server is started in.
DATA_DIR=./data

# Comma-separated browser origins allowed to call the API: the dashboard and the app's web build,
# e.g. https://dashboard.example.ac.uk,http://localhost:5173. Empty disables CORS (native iOS and
# Android apps do not need it).
CORS_ORIGINS=

# Largest accepted request body, in MB (larger uploads get 413).
MAX_UPLOAD_MB=25

# Set to true only when a reverse proxy you control sets X-Forwarded-For (needed for per-client
# rate limiting behind the proxy).
TRUST_PROXY=false

# fatal | error | warn | info | debug | trace | silent. Request bodies and Authorization headers
# are never logged at any level.
LOG_LEVEL=info
