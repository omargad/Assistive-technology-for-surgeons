{
  "name": "@surgeonpulse/server",
  "version": "0.1.0",
  "private": true,
  "description": "Reference research ingest API for SurgeonPulse (de-identified session upload, cohort export).",
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "build": "tsx scripts/build.ts",
    "start:dist": "node dist/main.js",
    "backup": "tsx src/backup.ts",
    "simulate": "tsx scripts/simulate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@surgeonpulse/core": "*",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  }
}
